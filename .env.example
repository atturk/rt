# .env.example
# Copiare in .env e inserire le proprie API key

API_KEY_NAME=your_api_key_here

# Telegram (RT 3.0 — conferma outline e notifiche)
RT_TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
RT_TELEGRAM_CHAT_ID=987654321

# Mini App: account Telegram autorizzati (ID numerici, separati da virgole).
# Nessun accesso Telegram finché questa lista non è configurata.
RT_TELEGRAM_MINI_APP_USER_IDS=
# Opzionale: bot dedicato alla Mini App. Se vuoto usa RT_TELEGRAM_BOT_TOKEN.
# Permette di collaudare un launcher separato senza cambiare il bot principale di RT.
RT_TELEGRAM_MINI_APP_BOT_TOKEN=

# Solo per un server STT custom che richiede autenticazione
# RT_STT_API_KEY=your_stt_api_key_here
