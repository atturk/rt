# .env.example
# Copiare in .env e inserire le proprie API key (il file .env non viene versionato)

# DeepSeek Official Platform
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter Gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini Dual-Key Projects (Due progetti Google Cloud / AI Studio indipendenti per quote separate)
GOOGLE_API_KEY_1=your_google_api_key_project_1_here
GOOGLE_API_KEY_2=your_google_api_key_project_2_here

# Legacy fallback per singola chiave Google Gemini
# GEMINI_API_KEY=your_gemini_key_here
