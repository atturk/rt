          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Token mostrato da 'rt api' al primo avvio",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nAPI locale di RT (utente singolo). Autenticazione: premi **Authorize** e incolla il token\nmostrato da `rt api` al primo avvio (header `Authorization: Bearer <token>`). Per un token\nnuovo: `rt api --reset-token`.\n\nLe operazioni lunghe (pipeline, fasi, trascrizione, immagini, recall) diventano job eseguiti\nda `rt worker`: l'endpoint risponde 202 con l'id del job, il progresso arriva da\n`GET /jobs/{id}/events` (Server-Sent Events).\n",
    "title": "RT API",
    "version": "rt"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
