# Gli archivi distribuiti contengono solo runtime, template e documentazione utente.
.agents/ export-ignore
.agent/ export-ignore
.claude/ export-ignore
tests/ export-ignore
.github/ export-ignore
scripts/ export-ignore
pytest.ini export-ignore
requirements-dev.txt export-ignore
docs/DEVELOPMENT.md export-ignore
docs/MAINTENANCE.md export-ignore
docs/INTERFACE_DIRECTION.md export-ignore
.gitattributes export-ignore
.gitignore export-ignore
frontend/ export-ignore
# Docker si usa da un clone del repository (l'immagine compila frontend/, escluso dall'archivio)
Dockerfile export-ignore
docker-compose.yml export-ignore
.dockerignore export-ignore
docker/ export-ignore
packaging/ export-ignore
# Su Windows git converte i fine riga in CRLF: i golden e le fixture si confrontano byte per byte
tests/golden/** text eol=lf
tests/fixtures/** -text
